class Solution {
    public String reverseWords(String s) {
        ArrayList<String> arr = new ArrayList<>();
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ' ') {
                if (sb.length() != 0) {
                    arr.add(0, sb.toString());
                    sb.setLength(0);
                }
            } else {
                sb.append(c);
            }
        }
        if (sb.length() != 0) arr.add(0, sb.toString());
        sb.setLength(0);
        int size = arr.size();
        for (int i = 0; i < size; i++) {
            sb.append(arr.get(i));
            if (i != size - 1) {
                sb.append(" ");
            }
        }
        return sb.toString();
    }
}